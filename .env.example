# ============================================================
# Gears — Environment Configuration
# ============================================================

# ------------------------------------------------------------
# Core
# ------------------------------------------------------------
# Data directory for SQLite databases, logs, and state (default: .gears/)
# GEARS_DATA_DIR=/var/lib/gears

# Timezone for cron scheduling (default: system timezone)
# GEARS_TIMEZONE=Europe/Stockholm

# ------------------------------------------------------------
# Worker
# ------------------------------------------------------------
# WORKER_CONCURRENCY=5
# WORKER_POLL_INTERVAL_MS=1000
# WORKER_RECOVERY_TIMEOUT_MS=300000
# WORKER_HEARTBEAT_INTERVAL_MS=30000

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
# LOG_LEVEL=info
# NODE_ENV=development

# ------------------------------------------------------------
# LLM Provider (optional — only needed if a bundle uses Gears' built-in ILLMProvider)
# ------------------------------------------------------------
# Gears does NOT create an LLM provider unless LLM_PROVIDER is explicitly set.
# Bundles that bring their own LLM (like Ivy) don't need this section.
#
# LLM_PROVIDER=ollama          # ollama | anthropic | gemini
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=your-model      # required when LLM_PROVIDER=ollama
# OLLAMA_API_KEY=               # optional, for Ollama Cloud
# ANTHROPIC_API_KEY=            # required when LLM_PROVIDER=anthropic
# ANTHROPIC_MODEL=              # required when LLM_PROVIDER=anthropic
# GEMINI_API_KEY=               # required when LLM_PROVIDER=gemini
# GEMINI_MODEL=                 # required when LLM_PROVIDER=gemini

# ------------------------------------------------------------
# Shared API keys (available to all bundles via process.env)
# ------------------------------------------------------------
# OLLAMA_HOST=https://ollama.com
# OLLAMA_API_KEY=your-ollama-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
# GEMINI_API_KEY=your-gemini-api-key

# ------------------------------------------------------------
# Integrations
# ------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=your-bot-token
# TELEGRAM_CHAT_ID=your-chat-id

# ------------------------------------------------------------
# Database (optional)
# ------------------------------------------------------------
# GEARS_APP_DB_PATH=app.sqlite
# GEARS_ALLOW_ABSOLUTE_DB_PATHS=1
